# Copy to .env.local and fill in with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose in client bundles. Required for privileged
# administrative operations (moderation, verification review) once configured.
# SUPABASE_SERVICE_ROLE_KEY=
