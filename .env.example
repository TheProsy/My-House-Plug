# Copy to .env.local and fill in with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of the app. Used for auth email redirects, metadata, and
# canonical URLs. Must also be listed in Supabase Auth -> URL Configuration
# (Site URL and Redirect URLs) or confirmation/reset links will fail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Optional: only needed for privileged operations that bypass RLS
# (currently unused; admin actions rely on staff RLS policies instead).
# SUPABASE_SERVICE_ROLE_KEY=
